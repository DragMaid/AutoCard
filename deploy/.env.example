# Production environment for docker-compose.prod.yml.
#
# The whole file (minus IMAGE_PREFIX / IMAGE_TAG, and the HF_TOKEN /
# AUTOCARD_WEIGHTS_URL overrides, which the workflow appends) is stored as the
# `PROD_ENV_FILE` secret on the GitHub `production` environment and written to
# /opt/autocard/.env on every deploy. Edit the secret, not the file on the
# server — the next rollout overwrites it.

# The public hostname, the one the Ansible vhost serves. The relay's CORS
# allow-list is exactly https://<this>, so it has to match what the browser
# actually loads the client from, PUBLIC_API_URL included.
SITE_DOMAIN=autocard.example.com
RELAY_PORT=8180

# How long a room outlives its relay socket. Longer than a redeploy takes, so a
# match in progress survives the relay reconnecting.
AUTOCARD_ROOM_TTL=300
# Seconds the AI seat pauses before acting, so its turn is readable.
AUTOCARD_AI_DELAY=0.8

# How long a disconnected player keeps their seat, and the cap on live rooms.
RECONNECT_GRACE_SECONDS=90
MAX_ROOMS=500

# The checkpoint the AI seat plays with. The engine refuses to start without it
# (see deploy/engine-entrypoint.sh), so a URL that 404s is a failed rollout, not
# a quietly untrained opponent.
#
# Leave unset to use the published default in ml/fetch_weights.py. The
# AUTOCARD_WEIGHTS_URL repository variable overrides whatever is here.
AUTOCARD_WEIGHTS_URL=
# Optional but recommended: `sha256sum autocard-bot.pth`. Pins the exact file,
# so a swapped or corrupted checkpoint is refused instead of loaded. Bumping it
# is also what makes an unchanged URL download again.
AUTOCARD_WEIGHTS_SHA256=

# Only needed while the model repository is private. Prefer the `HF_TOKEN`
# secret on the production environment, which the workflow appends.
HF_TOKEN=
