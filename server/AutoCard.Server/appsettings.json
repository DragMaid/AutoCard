{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "AutoCard": {
    "EngineUri": "ws://127.0.0.1:9000",
    "AllowedOrigins": [ "*" ],
    "ReconnectGraceSeconds": 90,
    "EngineHandshakeTimeoutSeconds": 10,
    "IntentsPerSecond": 20,
    "IntentBurst": 40,
    "MaxRooms": 500,
    "SweepIntervalSeconds": 15
  }
}
